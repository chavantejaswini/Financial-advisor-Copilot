# --- OpenAI ---
OPENAI_API_KEY=your-openai-api-key-here
# Optional: use your own endpoint (e.g. Azure OpenAI or proxy)
# OPENAI_BASE_URL=https://your-endpoint/v1

# --- Salesforce (simple-salesforce: SOQL + Task/Opp CRUD) ---
# Leave blank to run in CSV-fallback mode. See SALESFORCE_SETUP.md to fill these in.
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_DOMAIN=login
# Optional: full MyDomain URL (https://...my.salesforce.com). Used for OAuth when set;
# falls back to SF_DOMAIN otherwise. Required by some newer Dev Edition orgs.
SF_MYDOMAIN=

# Force a specific backend. Defaults to "salesforce" when SF vars above are set,
# otherwise "csv". Set to "csv" to demo offline.
# CRM_BACKEND=csv

# --- Agentforce (custom Agent / External Client App invoked via Agentforce API) ---
# The CLIENT_ID/SECRET are also used by simple-salesforce for OAuth login when set,
# which is required on newer Dev Edition orgs (SOAP login is disabled by default).
AGENTFORCE_AGENT_ID=
AGENTFORCE_CLIENT_ID=
AGENTFORCE_CLIENT_SECRET=
AGENTFORCE_API_VERSION=v62.0
